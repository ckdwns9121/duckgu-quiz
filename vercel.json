{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "crons": [{ "path": "/api/cron/daily-quiz", "schedule": "0 23 * * *" }],
  "routes": [
    { "src": "/sw.js", "headers": { "Cache-Control": "no-cache" }, "continue": true },
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "status": 404 },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
